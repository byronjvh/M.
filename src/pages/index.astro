---
import SlideDeck from "../components/SlideDeck";
import "../index.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>M.</title>
	</head>

	<body>
		<main>
			<SlideDeck client:load />
		</main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;
	}

	body {
		overflow: hidden;
	}

	main {
		width: 100%;
		height: 100%;
	}

	.deck {
		position: relative;
		width: 100%;
		height: 100dvh;
		overflow: hidden;

		perspective: 1800px;
	}

	.slide {
		position: absolute;
		inset: 0;

		width: 100%;
		height: 100%;

		display: flex;
		align-items: center;
		justify-content: center;

		transform-origin: top left;
		backface-visibility: hidden;
	}

	.slide h1 {
		margin: 0;
		color: #f5f3e9;
	}
</style>
